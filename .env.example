# ── Públicas (vão pro navegador — prefixo NEXT_PUBLIC_) ──
NEXT_PUBLIC_SUPABASE_URL=seu_url_do_supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publishable_do_supabase

# ── Segredos (SÓ servidor — configure na Vercel, NUNCA versione com valor real) ──
SUPABASE_SECRET_KEY=chave_service_role_do_supabase
ADMIN_EMAILS=admin@seu-dominio.com

# Se integração Vercel usar nomes compostos, mantenha chave SEM NEXT_PUBLIC_:
# SUPABASE_URL_SUPABASE_SECRET_KEY=chave_secreta_da_integracao
# Depois de migrar, remova/rotacione qualquer chave administrativa antiga com NEXT_PUBLIC_.

# Convite opcional do grupo do Parque. Sem valor, botão não aparece.
SELO_WHATSAPP_GRUPO_URL=

# Selo da Estação — check-in por GPS ("lat,lng" ou "lat,lng,raio_em_metros").
# Capture no painel /admin/selo → aba Check-in. Vazio = só foto do passaporte.
SELO_GEO_PARQUE=
SELO_GEO_POSTO=

# ── Selo da Estação: cópia em Google Sheets (oficial + reserva) ──
# Conta de serviço do Google Cloud com a API do Google Sheets ativada.
# Compartilhe AS DUAS planilhas com o e-mail da conta como "Editor".
GOOGLE_SA_EMAIL=
# Chave privada do JSON da conta (com \n). SÓ servidor, nunca NEXT_PUBLIC_.
GOOGLE_SA_PRIVATE_KEY=
# ID = trecho da URL entre /d/ e /edit. Use planilhas em pastas/donos diferentes.
SELO_PLANILHA_OFICIAL=
SELO_PLANILHA_RESERVA=
# Vercel Cron (cópia diária 03h de Brasília). Mínimo 16 caracteres aleatórios.
CRON_SECRET=
# Sal do hash de IP do limite de tentativas (aleatório, 32+ caracteres).
RATE_LIMIT_SALT=
